    { "file": "src/features/borrowers/detail-page.tsx", "exports": ["*"] },
    { "file": "src/features/borrowers/page.tsx", "exports": ["*"] },
    { "file": "src/features/dev/components-sandbox.tsx", "exports": ["*"] },
    { "file": "src/features/home/page.tsx", "exports": ["*"] },
    { "file": "src/features/loan-applications/detail-page.tsx", "exports": ["*"] },
    { "file": "src/features/loan-applications/page.tsx", "exports": ["*"] },
    { "file": "src/features/lsps/page.tsx", "exports": ["*"] },

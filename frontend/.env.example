# Base URL for the live Spring Boot backend.
# Override locally with `.env.local` if your backend is bound elsewhere.
VITE_API_BASE_URL=http://localhost:8080

# Optional: quick email prefill on /login — values must match real app_user rows
# in your backend. Passwords must never use the VITE_ prefix because Vite embeds
# all such values in public browser assets.
VITE_LOGIN_SYSTEM_ADMIN_EMAIL=siddhant@bhawanafinance.com
VITE_LOGIN_OPS_USER_EMAIL=ops.reviewer1@bhawana.local
VITE_LOGIN_PRODUCT_ADMIN_EMAIL=product.owner@bhawana.local
VITE_LOGIN_LSP_UI_READ_EMAIL=lsp.read1@bhawana.local
VITE_LOGIN_LSP_UI_WRITE_EMAIL=lsp.write1@bhawana.local

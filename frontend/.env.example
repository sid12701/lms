# Base URL for the live Spring Boot backend.
# Override locally with `.env.local` if your backend is bound elsewhere.
VITE_API_BASE_URL=http://localhost:8080

# Optional: quick role prefill on /login — usernames must match real app_user rows
# in your backend; passwords must match APP_SECURITY_BOOTSTRAP_PASSWORD (admin) or
# your demo-portfolio default (see backend LocalDemoPortfolioSeedService).
VITE_LOGIN_BOOTSTRAP_PASSWORD=ChangeMe123!
VITE_LOGIN_DEFAULT_PASSWORD=DemoPass123!
VITE_LOGIN_SYSTEM_ADMIN_USERNAME=ops.admin
VITE_LOGIN_OPS_USER_USERNAME=ops.reviewer1
VITE_LOGIN_PRODUCT_ADMIN_USERNAME=product.owner
VITE_LOGIN_LSP_UI_READ_USERNAME=lsp.read1
VITE_LOGIN_LSP_UI_WRITE_USERNAME=lsp.write1

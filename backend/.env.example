# Copy to backend/.env and adjust values. This file is safe to commit.
# Run the backend from the backend/ directory so Spring loads .env via application-local.yml.

# PostgreSQL (required) — set in repo-root .env (see backend/README.md).
# Local Docker: jdbc:postgresql://localhost:5432/lms?sslmode=disable  user=lms
# Supabase (Windows / IPv4): use Session pooler from Dashboard → Connect, not db.<ref>.supabase.co
#   (direct host is often IPv6-only and fails with UnknownHostException on Windows/Java).
# Example:
# LMS_DB_URL=jdbc:postgresql://aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# LMS_DB_USERNAME=postgres.<project-ref>
LMS_DB_URL=jdbc:postgresql://localhost:5432/lms?sslmode=disable
LMS_DB_USERNAME=lms
LMS_DB_PASSWORD=replace-me

# Redis / RabbitMQ / mail (optional — defaults match local docker-compose)
LMS_REDIS_HOST=localhost
LMS_REDIS_PORT=6379
LMS_RABBITMQ_HOST=localhost
LMS_RABBITMQ_PORT=5672
LMS_RABBITMQ_USERNAME=lms
LMS_RABBITMQ_PASSWORD=lms
LMS_MAIL_HOST=localhost
LMS_MAIL_PORT=1025

# Bootstrap admin (local dev only)
APP_SECURITY_BOOTSTRAP_USERNAME=ops.admin
APP_SECURITY_BOOTSTRAP_PASSWORD=ChangeMe123!

# JWT signing secret — at least 32 characters (required)
APP_SECURITY_JWT_SECRET=replace-with-at-least-32-character-local-dev-secret

# Tenant datasource role (Flyway placeholders / RLS)
APP_TENANT_DATASOURCE_USERNAME=lms_tenant_app
APP_TENANT_DATASOURCE_PASSWORD=lms_tenant_app_password

# Document / report object storage (optional for local)
APP_STORAGE_DOCUMENTS_PROVIDER=R2
APP_STORAGE_DOCUMENTS_R2_ENDPOINT=
APP_STORAGE_DOCUMENTS_R2_ACCESS_KEY=
APP_STORAGE_DOCUMENTS_R2_SECRET_KEY=
APP_STORAGE_DOCUMENTS_R2_BUCKET=
APP_STORAGE_DOCUMENTS_R2_REGION=auto
APP_STORAGE_REPORTS_R2_ENDPOINT=
APP_STORAGE_REPORTS_R2_ACCESS_KEY=
APP_STORAGE_REPORTS_R2_SECRET_KEY=
APP_STORAGE_REPORTS_R2_BUCKET=
APP_STORAGE_REPORTS_R2_REGION=auto

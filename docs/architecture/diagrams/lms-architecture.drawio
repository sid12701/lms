        <!-- Title -->
        <mxCell id="title" value="Bhawana Loan Management System — Platform Architecture&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Multi-tenant LMS · cloud-agnostic on Kubernetes · target ~100K loans/day · disbursement adapter currently mocked&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=20;html=1;" vertex="1" parent="1">

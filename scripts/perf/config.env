# Copy to scripts/perf/config.env and adjust.
# For load tests, disable or raise rate limits in backend .env:
#   APP_RATE_LIMIT_ENABLED=false
#   APP_RATE_LIMIT_LSP_WRITE_PER_MINUTE=6000
#   APP_RATE_LIMIT_AUTH_PER_MINUTE=600

BASE_URL=http://localhost:8080
FRONTEND_URL=http://127.0.0.1:5173

ADMIN_USERNAME=ops.admin
ADMIN_PASSWORD=ChangeMe123!

# Unique prefix per run — isolates tenants and avoids collisions
PERF_RUN_PREFIX=PERF

# Fixture reuse: path written by `python fixtures.py --export`
PERF_FIXTURES_JSON=.perf-runs/fixtures.json

# Scenario tuning (override per scenario in run.py)
PERF_CONCURRENCY=10
PERF_RAMP_UP_SEC=30
PERF_RAMP_DOWN_SEC=15
PERF_DURATION_SEC=300
PERF_ITERATIONS=0

# Target load model (100k loans/day profile)
PERF_TARGET_LOANS_PER_DAY=100000
PERF_PEAK_FACTOR=3.5
PERF_BURST_FACTOR=10

# Document storage for uploads (local profile)
APP_STORAGE_DOCUMENTS_PROVIDER=FILE_SYSTEM

# Reporting output
PERF_REPORT_DIR=.perf-runs/reports

# Optional: Postgres metrics (read-only monitoring queries)
# LMS_DB_URL=postgresql://lms:password@localhost:5432/lms

# Playwright UI sampling during API load
PERF_UI_SAMPLE_PAGES=home,loan-applications,reports
PERF_UI_CONCURRENT_BROWSERS=2

# Copy to scripts/e2e/config.env and adjust. Restart backend after rate-limit changes.

BASE_URL=http://localhost:8080
FRONTEND_URL=http://127.0.0.1:5173

ADMIN_USERNAME=ops.admin
ADMIN_PASSWORD=ChangeMe123!

# Lower limits to make EC-074..076 reachable in burst scripts
APP_RATE_LIMIT_AUTH_PER_MINUTE=5
APP_RATE_LIMIT_LSP_WRITE_PER_MINUTE=10

# Fixture naming prefix (isolates edge runs from Newman happy path)
E2E_FIXTURE_PREFIX=E2E-EDGE

# Webhook mock (start scripts/e2e/webhook-mock/server.py)
E2E_WEBHOOK_MOCK_URL=http://127.0.0.1:9090/hook
E2E_WEBHOOK_MOCK_5XX_URL=http://127.0.0.1:9090/status/500
E2E_WEBHOOK_MOCK_4XX_URL=http://127.0.0.1:9090/status/404
E2E_WEBHOOK_SSRF_URL=http://169.254.169.254/latest/meta-data

# IP allowlist phase — CIDR that does NOT include 127.0.0.1
E2E_ALLOWLIST_CIDR=10.255.255.0/24

# Paths (auto-filled by fixtures.py --export)
E2E_FIXTURES_JSON=.e2e-runs/edge-fixtures.json
E2E_MATRIX=e2e-test-matrix.xlsx

# EC-068 MIS CSV perf gate — auto-seeds disbursed loans via fixtures when below minimum
E2E_EC068_MIN_LOANS=100
E2E_EC068_AUTO_SEED=true
